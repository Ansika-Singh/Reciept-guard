# ==============================================================================
# ReceiptGuard AI Environment Configuration
# ==============================================================================

# Project & Metadata
PROJECT_NAME="ReceiptGuard AI"
VERSION="1.0.0"
API_V1_STR="/api"

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# LOCAL (Default): SQLite
# DATABASE_URL="sqlite:///./receiptguard.db"
#
# PRODUCTION (Vercel / Supabase): PostgreSQL
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. File & Vault Storage Provider
# ------------------------------------------------------------------------------
# LOCAL (Default): "local" (uses uploads/vault/ or /tmp on serverless)
STORAGE_PROVIDER=local

# PRODUCTION (Supabase Object Storage):
# STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJh...
# SUPABASE_STORAGE_BUCKET=receipt-vault

# ------------------------------------------------------------------------------
# 3. AI & Chat Provider
# ------------------------------------------------------------------------------
# Options: "deterministic" (zero-dependency grounded engine), "openai", or "ollama"
# In Vercel serverless, "deterministic" is the default safe mode if no API key is provided.
AI_PROVIDER=deterministic

# For external LLM generation (OpenAI, Groq, OpenRouter, etc.):
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1

# For local offline Ollama (Docker / Local dev only):
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# ------------------------------------------------------------------------------
# 4. OCR / Document Extraction Provider
# ------------------------------------------------------------------------------
# Options: "auto", "local" (RapidOCR), or "openai"
OCR_PROVIDER=auto
# OCR_API_KEY=sk-...

# ------------------------------------------------------------------------------
# 5. Vector Store & Retrieval Engine
# ------------------------------------------------------------------------------
# Options: "db" (relational database grounded retrieval, recommended for Vercel)
# or "chroma" (local ChromaDB persistent client for local dev)
VECTOR_STORE_PROVIDER=db

# ------------------------------------------------------------------------------
# 6. Operational & Security Settings
# ------------------------------------------------------------------------------
DEMO_MODE=false
MAX_UPLOAD_SIZE_MB=15
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://*.vercel.app"]

# ------------------------------------------------------------------------------
# 7. Frontend Client Configuration
# ------------------------------------------------------------------------------
# In production on Vercel, leave empty so the client uses relative /api routing.
# In local development, defaults automatically to http://localhost:8000.
VITE_API_URL=
