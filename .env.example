# AI Model Providers for ReceiptGuard AI
# You can choose between:
# 1. Local Built-in Engine (Default: 100% offline, no key needed)
# 2. Groq Vision API (Free instant key from https://console.groq.com/keys)
# 3. Google Gemini API (https://aistudio.google.com/apikey)

# Optional Groq API Key (ultra-fast Llama-3.2 vision)
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional Gemini API Key
VITE_GEMINI_API_KEY=your_gemini_api_key_here
